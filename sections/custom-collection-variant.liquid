
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign form_id = 'collection-form-' | append: product.id %}

<div class="custom-collection-variant">

  <form action="/cart/add" method="post" id="{{ form_id }}">

    <select name="id" class="variant-select">

      {% for variant in product.variants %}

        <option
          value="{{ variant.id }}"
          {% if variant.id == current_variant.id %}selected{% endif %}
          {% unless variant.available %}disabled{% endunless %}
        >
          {{ variant.title }}
          {% unless variant.available %} - Sold Out{% endunless %}
        </option>

      {% endfor %}

    </select>

    <button type="submit" class="add-cart-btn">
      Add to cart
    </button>

  </form>

</div>


<style>

.custom-collection-variant {
  margin-top: 15px;
}

.variant-select {
  width: 100%;
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 5px;
  margin-bottom: 10px;
}

.add-cart-btn {
  width: 100%;
  padding: 15px;
  background: black;
  color: white;
  border: none;
  border-radius: 30px;
  cursor: pointer;
}

</style>